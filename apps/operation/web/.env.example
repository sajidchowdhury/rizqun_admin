# ─── API ─────────────────────────────────────────────
# Backend API base URL. In dev, the Vite proxy forwards /api/* → :3000.
# In production, Nginx proxies /api/* → the Express server.
# Default '/api' works for both local dev (proxy) and production (Nginx).
VITE_API_BASE_URL=/api

# ─── Router basename ─────────────────────────────────
# Must match the Vite `base` config. The admin is served at /operation/.
VITE_BASE_PATH=/operation/
