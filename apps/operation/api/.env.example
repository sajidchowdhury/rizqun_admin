# ─── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://rizqun_user:rizqun_password@127.0.0.1:5432/rizqun_db?schema=public

# ─── Auth ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_a_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_me_with_another_64_char_random_hex_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Super Admin (used by seed script) ───────────────
SUPER_ADMIN_EMAIL=admin@rizqun.com
SUPER_ADMIN_PASSWORD=ChangeMeInProduction123!

# ─── CORS ────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production: https://rizqunbd.com,https://www.rizqunbd.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── API prefix ──────────────────────────────────────
# All routes are mounted under this prefix so the API can coexist
# with the landing page (/) and admin console (/operation/) on one domain.
# Nginx proxies /api/* → this Express server.
API_PREFIX=/api
